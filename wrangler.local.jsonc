{
  // Local-only bindings for `npm run dev:local` — never points at production D1/R2.
  "name": "goldqueen-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "R2_BUCKET_NAME": "makeup",
    "R2_PUBLIC_URL": "http://localhost:3000/__local_r2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goldqueen-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "makeup-local" }]
}
