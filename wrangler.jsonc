{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goldqueen",
  "main": ".open-next/worker.js",

  "compatibility_date": "2026-04-29",

  "workers_dev": true,

  "routes": [
    {
      "pattern": "goldqueen.store",
      "custom_domain": true
    },
    {
      "pattern": "www.goldqueen.store",
      "custom_domain": true
    }
  ],

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "vars": {
    "R2_BUCKET_NAME": "makeup",
    "R2_PUBLIC_URL": "https://cdn.goldqueen.store"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goldqueen",
      "database_id": "d3098073-2721-4613-a95b-4d5e53fe33f7",
      "remote": true,
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "makeup"
    }
  ],

  // Enables real resizing/format conversion for /_next/image (legacy and external images).
  // Without this binding OpenNext returns the original file untouched.
  "images": {
    "binding": "IMAGES"
  },

  "observability": {
    "enabled": true
  }
}